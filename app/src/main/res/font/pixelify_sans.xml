<?xml version="1.0" encoding="utf-8"?>
<!--
    NOTE: This font family definition requires the actual font files
    'pixelify_sans_regular.ttf' and 'pixelify_sans_bold.ttf' (or .otf)
    to be placed in the app/src/main/res/font/ directory.
    The current files are placeholders.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/pixelify_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400"
        app:font="@font/pixelify_sans_regular"/>
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/pixelify_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700"
        app:font="@font/pixelify_sans_bold"/>
</font-family>
