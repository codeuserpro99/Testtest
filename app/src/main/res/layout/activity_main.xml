<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_navigation_view"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"> // Added padding to avoid content hiding behind nav bar before scroll

            <include
                layout="@layout/header_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <androidx.cardview.widget.CardView
                android:id="@+id/album_art_cardview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="48dp"
                android:layout_marginTop="32dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/darker_gray">

                <ImageView
                    android:id="@+id/album_art_imageview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:src="@drawable/placeholder_album_art"
                    android:scaleType="fitCenter"/>

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/song_title_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="Song Title Placeholder"
                android:textAppearance="@style/TextAppearance.App.PixelFont"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/artist_name_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Artist Name"
                android:textAppearance="@style/TextAppearance.App.PixelFont"
                android:textColor="@color/bright_red"
                android:textSize="18sp"/>

            <ProgressBar
                android:id="@+id/song_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:layout_marginTop="24dp"
                android:max="100"
                android:progress="30"
                android:progressDrawable="@drawable/custom_progress_bar" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/elapsed_time_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="1:23"
                    android:textAppearance="@style/TextAppearance.App.PixelFont"
                    android:textColor="@color/time_label_muted_rose"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/total_duration_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="4:56"
                    android:textAppearance="@style/TextAppearance.App.PixelFont"
                    android:textColor="@color/time_label_muted_rose"
                    android:textSize="12sp"/>
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/playback_controls_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|center_horizontal"
                android:layout_marginTop="24dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp">

                <ImageButton
                    android:id="@+id/previous_track_button"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/circular_semi_transparent_dark_red_background"
                    android:src="@drawable/ic_skip_previous_24dp"
                    android:contentDescription="Previous Track"
                    android:elevation="4dp"
                    android:padding="12dp"
                    android:scaleType="fitCenter"/>

                <ImageButton
                    android:id="@+id/play_pause_button"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/circular_bright_red_background"
                    android:src="@drawable/ic_play_arrow_24dp"
                    android:contentDescription="Play or Pause"
                    android:elevation="6dp"
                    android:padding="16dp"
                    android:scaleType="fitCenter"/>

                <ImageButton
                    android:id="@+id/next_track_button"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/circular_semi_transparent_dark_red_background"
                    android:src="@drawable/ic_skip_next_24dp"
                    android:contentDescription="Next Track"
                    android:elevation="4dp"
                    android:padding="12dp"
                    android:scaleType="fitCenter"/>
            </LinearLayout>

            <Button
                android:id="@+id/show_mock_dialog_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="Show Mock Dialog (For Testing Auto-Accept)"
                android:textAppearance="@style/TextAppearance.App.PixelFont"
                android:padding="12dp"
                android:backgroundTint="@color/bright_red"
                android:textColor="@color/white"/>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@drawable/bottom_nav_item_color_selector"
        app:itemTextColor="@drawable/bottom_nav_item_color_selector"
        app:itemTextAppearanceActive="@style/TextAppearance.App.PixelFont.Small.Active"
        app:itemTextAppearanceInactive="@style/TextAppearance.App.PixelFont.Small.Inactive"
        />

</RelativeLayout>
